digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.7", label="Mapa de dominio y responsabilidades", labelloc=t, fontsize=20]; node [shape=record, style="rounded,filled", fillcolor="#F3F6FA", color="#355070", fontname="Arial", fontsize=10]; edge [color="#52616B", fontname="Arial", fontsize=9, arrowsize=.7];
subgraph cluster_dom {label="Dominio"; color="#6C8EAD"; Reservacion [label="{Reservación|id · estado · fechas|confirmar / cancelar}"]; Habitacion [label="{Habitación|id · estado operativo|ocupar / limpiar / liberar}"]; Estancia [label="{Estancia|check-in · check-out|cerrar}"]; Cuenta [label="{Cuenta del huésped|cargos · total|agregar cargo}"]; Consumo [label="{Consumo|fecha · concepto · monto|capturado por}"]; VO [label="{Value Objects|Dinero · RangoFechas|sin identidad propia}", fillcolor="#E6F4EA"]; Hist [label="{Historial de cambio|fecha · anterior · nueva|responsable}"]; }
subgraph cluster_app {label="Aplicación"; color="#D49B54"; S1 [label="{CheckInService|coordina check-in}", fillcolor="#FFF3D6"]; S2 [label="{CheckOutService|coordina cierre y limpieza}", fillcolor="#FFF3D6"]; S3 [label="{ConsultarDisponibilidad|solo lectura}", fillcolor="#FFF3D6"]; }
subgraph cluster_ports {label="Puertos"; color="#7B6DAB"; Repo [label="{Repositories|buscar / guardar}", fillcolor="#F0EAFE"]; UOW [label="{Unit of Work|confirmar / revertir}", fillcolor="#F0EAFE"]; }
Reservacion -> Habitacion [label="asigna"]; Reservacion -> Estancia [label="origina"]; Estancia -> Cuenta [label="consolida"]; Cuenta -> Consumo [label="contiene"]; Consumo -> VO [label="monto"]; Reservacion -> VO [label="fechas"]; Habitacion -> Hist [label="cambios trazables"]; S1 -> Repo; S2 -> Repo; S2 -> UOW; S3 -> Repo;
}