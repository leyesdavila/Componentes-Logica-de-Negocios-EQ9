digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.4", label="Secuencia simplificada de check-in", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#355070", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#52616B", arrowsize=.7]; A [label="Recepción"]; B [label="CheckInService",fillcolor="#FFF3D6"]; C [label="ReservacionRepository",fillcolor="#F0EAFE"]; D [label="HabitacionRepository",fillcolor="#F0EAFE"]; E [label="Dominio: validar reglas",fillcolor="#E6F4EA"]; F [label="Unit of Work: confirmar",fillcolor="#F0EAFE"]; A->B [label="solicitar check-in"]; B->C [label="obtener reservación"]; C->B [label="reservación"]; B->D [label="obtener habitación"]; D->B [label="estado habitación"]; B->E [label="validar garantía, estado e identidad"]; E->F [label="si válido"]; F->A [label="confirmado"]; E->A [label="si falla: rechazo con motivo",style=dashed]; }