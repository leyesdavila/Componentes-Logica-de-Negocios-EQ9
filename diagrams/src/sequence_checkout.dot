digraph G { graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="0.4", label="Secuencia simplificada de check-out", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#F3F6FA", color="#355070", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#52616B", arrowsize=.7]; A [label="Recepción"]; B [label="CheckOutService",fillcolor="#FFF3D6"]; C [label="EstanciaRepository",fillcolor="#F0EAFE"]; D [label="CuentaHuespedRepository",fillcolor="#F0EAFE"]; E [label="HabitacionRepository",fillcolor="#F0EAFE"]; F [label="Unit of Work",fillcolor="#F0EAFE"]; A->B [label="solicitar cierre"]; B->C [label="obtener estancia"]; C->B [label="estancia activa"]; B->D [label="consultar cargos"]; D->B [label="total de cuenta"]; B->E [label="enviar habitación a limpieza"]; B->F [label="confirmar cambios si saldo liquidado"]; F->A [label="cierre registrado"]; B->A [label="saldo pendiente: no cerrar",style=dashed]; }