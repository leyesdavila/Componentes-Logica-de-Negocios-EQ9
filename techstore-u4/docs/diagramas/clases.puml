' Modelo de dominio de TechStore U4 — diagrama de clases
' Formato UML clásico del curso. Renderizar en plantuml.com o con la extensión de VS Code.
@startuml
title Modelo de dominio de TechStore U4 — diagrama de clases
skinparam classAttributeIconSize 0

class Money <<value object>> {
  + amount: Decimal
  + currency: str
  + add(other: Money): Money
  + apply_percentage(percentage: Decimal): Money
}

class Customer <<entidad>> {
  + id: str
  + is_vip: bool
  + active: bool
}

class OrderItem <<value object>> {
  + sku: str
  + quantity: int
  + unit_price: Money
  + subtotal(): Money
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

class DomainEvent <<value object>> {
  + name: str
  + order_id: str
  + occurred_at: datetime
}

class Order <<aggregate root>> {
  + id: str
  + has_promotion: bool
  + status: OrderStatus
  + tracking_number: str
  + cancel_reason: str
  + units(): int
  + total(): Money
  + is_empty(): bool
  + add_item(item: OrderItem): void
  + confirm(): void
  + ship(tracking_number: str): void
  + cancel(reason: str): void
  + deliver(): void
  + return_order(): void
}

class DomainException <<exception>>
class InvalidOrderData <<exception>>
class InvalidOrderTransition <<exception>>
class OrderItemLimitExceeded <<exception>>

Order "1" *-- "1" Customer : cliente
Order "1" *-- "0..*" OrderItem : renglones
Order "1" *-- "0..*" DomainEvent : events
Order --> "1" OrderStatus : status
OrderItem "1" --> "1" Money : unit_price
Order ..> InvalidOrderData : lanza
Order ..> InvalidOrderTransition : lanza
Order ..> OrderItemLimitExceeded : lanza
Order ..> DomainEvent : crea
DomainException <|-- InvalidOrderData
DomainException <|-- InvalidOrderTransition
DomainException <|-- OrderItemLimitExceeded

note right of Money
  Inmutable (frozen): cada operación
  devuelve una instancia nueva.
end note
note right of Order
  units, total e is_empty
  son propiedades derivadas.
end note
note right of OrderItem
  subtotal = unit_price x quantity;
  no se captura.
end note
@enduml
